<navigation-bar title="销售业务量导入" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="page-container" scroll-y>
  <view class="collect-container" wx:if="{{canImport || canMaintain}}">
    <view class="card" wx:if="{{canImport && !maintenanceOnly}}">
      <view class="card-title">月度累计业务量</view>
      <view class="form-group">
        <label>业务月份（T月）</label>
        <picker mode="date" fields="month" value="{{businessMonth}}" bindchange="onMonthChange" disabled="{{busy}}">
          <view class="form-picker">{{businessMonth}}</view>
        </picker>
      </view>
      <view class="form-group">
        <label>统计截止日期</label>
        <picker mode="date" value="{{cutoffDate}}" bindchange="onCutoffChange" disabled="{{busy}}">
          <view class="form-picker">{{cutoffDate}}</view>
        </picker>
      </view>
      <view class="form-group">本次为最终数据 <switch checked="{{finalized}}" bindchange="onFinalizedChange" disabled="{{busy}}" /></view>
      <view class="import-tips">表头：区县、网格名称、装维人员姓名、员工编号及8类业务数量。数量空白按0，员工编号须为文本。</view>
      <button class="btn btn-secondary" bindtap="chooseFile" disabled="{{busy}}">{{file ? file.name : '选择Excel'}}</button>
      <view class="import-actions">
        <button class="btn btn-secondary" bindtap="previewImport" loading="{{importAction === 'preview'}}" disabled="{{busy || !file}}">校验与预览</button>
        <button class="btn btn-primary" bindtap="commitImport" loading="{{importAction === 'publish'}}" disabled="{{busy || !preview || preview.errors.length > 0}}">确认覆盖并发布{{finalized ? '、定版' : ''}}</button>
      </view>
    </view>
    <view class="card" wx:if="{{preview}}">
      <view class="card-title">校验结果</view>
      <view>自动识别区县：{{preview.meta.districts}}</view>
      <view class="import-tips">仅覆盖以上区县；文件未包含的区县保持原数据。</view>
      <view wx:if="{{preview.unchanged}}">数据与当前版本完全一致，发布不会重复更新参与率。</view>
      <view>员工{{preview.totalEmployees}}人，业务{{preview.totalQuantity}}笔，总酬金￥{{preview.totalCommission}}</view>
      <view class="import-tips" wx:if="{{!preview.errorCount && !preview.differenceCount}}">校验通过，无需逐条核对的问题，可确认覆盖并发布。</view>
      <view class="error-item" wx:if="{{preview.errorCount}}">共{{preview.errorCount}}行校验错误，须修正后重新校验（最多展示100行）：</view>
      <view class="error-item" wx:for="{{preview.errors}}" wx:key="index">第{{item.rowNumber}}行 {{item.employeeId}}：{{item.errors}}</view>
      <view class="import-tips" wx:if="{{preview.differenceCount}}">共{{preview.differenceCount}}人存在覆盖提醒，请核对后再发布；提醒不阻止发布（最多展示100人）：</view>
      <view class="preview-row" wx:for="{{preview.differences}}" wx:key="employeeId">
        <view>{{item.employeeId}} {{item.realName}}：{{item.missing ? '文件缺失，将移除原业务量' : '总业务量或酬金减少，请核对'}}</view>
        <view>{{item.previousQuantity}}→{{item.quantity}}笔，￥{{item.previousCommission}}→￥{{item.commission}}</view>
      </view>
    </view>
    <view class="card">
      <view class="card-title">区县数据维护</view>
      <view class="preview-row" wx:for="{{activeVersions}}" wx:key="_id">
        {{item.businessMonth}} {{item.district}} · {{item.finalized ? '已定版' : '更新中'}} · 截至{{item.cutoffDate}}
        <button wx:if="{{canImport && item.finalized}}" size="mini" data-index="{{index}}" bindtap="reopenMonth" disabled="{{busy}}">撤销定版</button>
        <button wx:if="{{canMaintain && !item.finalized}}" size="mini" data-index="{{index}}" bindtap="clearDistrictMonth" disabled="{{busy}}">更正：清空本区县当月数据</button>
      </view>
    </view>
    <view class="card">
      <view class="card-title">最近导入批次</view>
      <view class="preview-row" wx:for="{{batches}}" wx:key="_id">
        {{item.businessMonth}} {{item.districts}} · 截至{{item.cutoffDate}} · {{item.totalEmployees}}人 / {{item.totalQuantity}}笔
      </view>
    </view>
    <view class="card">
      <view class="card-title">认领更正</view>
      <input class="form-input" value="{{employeeId}}" bindinput="onEmployeeInput" placeholder="需要解除认领的员工编号" />
      <button class="btn btn-secondary" bindtap="releaseClaim" disabled="{{busy}}">解除错误认领</button>
    </view>
  </view>
  <view class="card" wx:else>仅指定导入人员或系统管理员可访问。</view>
</scroll-view>
