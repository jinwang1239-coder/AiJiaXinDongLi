.page-container { height: 100vh; background: #f5f7fa; }
.collect-container { padding: 24rpx; padding-bottom: 140rpx; }
.card { margin-bottom: 24rpx; padding: 28rpx; border-radius: 20rpx; background: #fff; }
.card-title { font-size: 32rpx; font-weight: 600; margin-bottom: 20rpx; }
.import-tips { color: #68758a; font-size: 26rpx; line-height: 1.7; margin: 18rpx 0; }
.form-group { margin: 24rpx 0; }
.form-picker { padding: 20rpx; background: #f3f6fa; border-radius: 12rpx; margin-top: 12rpx; }
.preview-row { font-size: 26rpx; padding: 18rpx 0; border-bottom: 1rpx solid #edf0f5; }
.error-item { color: #bf3030; padding: 12rpx 0; }
button { margin-top: 20rpx; }
.import-actions { display: flex; gap: 16rpx; margin-top: 20rpx; align-items: stretch; }
.import-actions .btn { flex: 1; min-width: 0; margin: 0; padding: 20rpx 12rpx; font-size: 26rpx; line-height: 1.5; white-space: normal; }
