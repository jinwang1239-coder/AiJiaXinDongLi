<navigation-bar title="{{navTitle}}" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="page-container" scroll-y>
  <view class="evidence-page">
    <view class="card month-card">
      <view class="card-header">
        <view class="card-title">结算月份</view>
        <button class="btn btn-secondary mini-btn" bindtap="loadRecords" loading="{{loading}}">刷新</button>
      </view>
      <picker mode="date" value="{{monthPickerValue}}" bindchange="onMonthChange">
        <view class="month-picker">{{settlementMonth}}</view>
      </picker>
      <view class="scope-text">{{scopeText}}</view>
      <view class="month-status status-{{monthStatus}}">{{monthStatusText}}</view>
    </view>

    <view wx:if="{{canUpload}}" class="card upload-card">
      <view class="card-title">提交项目附件材料</view>
      <view class="notice">有特殊场景时请输入项目编号查询并关联；系统不识别、不分析图片内容。</view>
      <view class="project-search-row">
        <input class="project-search-input" value="{{projectKeyword}}" placeholder="请输入项目编号/工单号" confirm-type="search" bindinput="onProjectKeywordInput" bindconfirm="searchProjects" />
        <button class="btn btn-secondary project-search-btn" bindtap="searchProjects" loading="{{projectSearching}}">查询</button>
      </view>
      <view wx:if="{{selectedProject}}" class="selected-project">
        <view class="selected-project-label">已关联项目</view>
        <view class="selected-project-code">{{selectedProject.workOrderCode || '未识别项目编号'}}</view>
        <view class="selected-project-title">{{selectedProject.workOrderSubject || selectedProject.workOrderNameRaw}}</view>
        <view class="project-result-meta">{{selectedProject.subCategory}} · {{selectedProject.district}}</view>
      </view>
      <view wx:if="{{projectResults.length}}" class="project-results">
        <view class="project-result" wx:for="{{projectResults}}" wx:key="workOrderKey" data-index="{{index}}" bindtap="selectProject">
          <view class="project-result-main">
            <view class="project-result-code">{{item.workOrderCode || '未识别项目编号'}}</view>
            <view class="project-result-title">{{item.workOrderSubject || item.workOrderNameRaw}}</view>
            <view class="project-result-meta">{{item.subCategory}} · {{item.district}}</view>
          </view>
          <view class="project-result-action">关联</view>
        </view>
      </view>
      <view wx:if="{{selectedImages.length}}" class="image-grid">
        <view class="image-item" wx:for="{{selectedImages}}" wx:key="tempFilePath">
          <image class="evidence-image" src="{{item.tempFilePath}}" mode="aspectFill" data-index="{{index}}" bindtap="previewSelectedImage" />
          <view class="remove-image" data-index="{{index}}" catchtap="removeSelectedImage">×</view>
        </view>
      </view>
      <button wx:if="{{selectedImages.length < 9}}" class="btn btn-secondary action-btn" bindtap="chooseImages">选择图片</button>
      <button class="btn btn-primary action-btn" bindtap="submitEvidence" loading="{{uploading}}" disabled="{{!selectedImages.length || !selectedProject}}">提交附件材料</button>
      <button wx:if="{{monthStatus === 'unconfirmed'}}" class="btn btn-secondary action-btn" bindtap="confirmNoSpecialScenario" loading="{{confirming}}">本月无特殊场景</button>
    </view>

    <view class="card records-card">
      <view class="records-header">
        <view class="card-title">已提交附件材料</view>
        <view class="record-count">{{projectGroups.length}} 个项目/分组</view>
      </view>
      <view wx:if="{{projectGroups.length}}" class="record-list">
        <view class="project-group" wx:for="{{projectGroups}}" wx:key="workOrderKey" wx:for-item="projectGroup">
          <view class="project-title">{{projectGroup.legacy ? '历史未关联材料' : projectGroup.projectTitle}}</view>
          <view wx:if="{{!projectGroup.legacy}}" class="project-meta">{{projectGroup.subCategory}} · 项目号/工单号：{{projectGroup.projectCode || '未识别'}}</view>
          <view wx:else class="project-meta">历史材料未自动关联项目，可继续查看原图片。</view>
          <view class="project-meta">{{projectGroup.records.length}} 组材料 · {{projectGroup.imageCount}} 张图片</view>
          <view class="record-item" wx:for="{{projectGroup.records}}" wx:key="_id" wx:for-item="record">
            <view class="record-title">{{record.district}} · {{record.uploaderName}}</view>
            <view class="record-meta">{{record.createTimeText}} · {{record.totalImageCount}} 张</view>
            <view wx:if="{{record.imageUrls.length}}" class="image-grid record-images">
              <image
                class="evidence-image"
                wx:for="{{record.imageUrls}}"
                wx:key="*this"
                wx:for-item="imageUrl"
                src="{{imageUrl}}"
                mode="aspectFill"
                data-url="{{imageUrl}}"
                bindtap="previewRecordImage"
              />
            </view>
            <view wx:if="{{record.failedImageCount}}" class="image-error">{{record.failedImageCount}} 张图片暂时无法加载，请点击刷新重试</view>
          </view>
        </view>
      </view>
      <view wx:else class="empty-text">{{monthStatus === 'no_special_scenario' ? '本月已确认无特殊场景，无需上传材料' : '当前月份暂无附件材料'}}</view>
    </view>
  </view>
</scroll-view>

<view wx:if="{{previewVisible}}" class="image-preview-mask" bindtap="closeImagePreview" catchtouchmove="stopPropagation">
  <view class="image-preview-content">
    <view class="image-preview-close">关闭预览</view>
    <image class="image-preview-main" src="{{previewUrl}}" mode="aspectFit" binderror="onPreviewImageError" />
  </view>
</view>
