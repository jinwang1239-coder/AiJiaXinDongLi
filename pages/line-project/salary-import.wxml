<navigation-bar title="整体工资导入" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="page-container" scroll-y>
  <view class="line-project-page">
    <view wx:if="{{!canImport}}" class="card">
      <view class="card-title">当前账号没有导入权限</view>
      <view class="tip-text">个人整体工资包含敏感信息，仅系统管理员可以导入。</view>
    </view>

    <block wx:else>
      <view class="card">
        <view class="card-header">
          <view class="card-title">导入条件</view>
          <view class="tag tag-primary">整体工资</view>
        </view>
        <view class="filter-grid single-grid">
          <view class="filter-item">
            <text class="filter-label">结算月份</text>
            <picker mode="date" value="{{monthPickerValue}}" bindchange="onMonthChange">
              <view class="filter-value">{{settlementMonth}}</view>
            </picker>
          </view>
        </view>
        <view class="tip-text">模板列顺序：序号、区县、人员编码、人员姓名、固定报酬、量化报酬、企业代扣代缴、个人代扣代缴、实发报酬。区县为必填项并作为区县薪酬归属依据。</view>
        <view class="tip-text">人员编码用于匹配网格通账号；实发报酬按“固定报酬＋量化报酬－个人代扣代缴”核对。</view>
      </view>

      <view class="card">
        <view class="card-header"><view class="card-title">工资文件</view></view>
        <view wx:if="{{importFile}}" class="file-panel">
          <view class="file-name">{{importFile.name}}</view>
          <view class="file-meta">大小 {{importFile.size || 0}} bytes</view>
          <view class="action-row">
            <button class="btn btn-secondary half-btn" bindtap="chooseImportFile">重新选择</button>
            <button class="btn btn-secondary half-btn" bindtap="clearImportFile">清空</button>
          </view>
        </view>
        <view wx:else class="empty-panel">
          <view class="empty-text">请选择“合企平台人员报酬明细”Excel 文件</view>
          <button class="btn btn-primary full-btn" bindtap="chooseImportFile">选择文件</button>
        </view>
        <view class="action-row top-gap">
          <button class="btn btn-primary half-btn" bindtap="previewImport" loading="{{previewing}}">预解析</button>
          <button class="btn btn-success half-btn" bindtap="commitImport" loading="{{importing}}">正式导入</button>
        </view>
      </view>

      <view wx:if="{{previewResult}}" class="card">
        <view class="card-header">
          <view class="card-title">预解析结果</view>
          <view class="tag {{previewResult.hasBlockingErrors ? 'tag-warning' : 'tag-success'}}">{{previewResult.hasBlockingErrors ? '存在阻断错误' : '可以导入'}}</view>
        </view>
        <view class="stats-grid">
          <view class="stats-tile"><view class="stats-number">{{previewResult.summary.totalRows}}</view><view class="stats-label">总人数</view></view>
          <view class="stats-tile"><view class="stats-number">{{previewResult.summary.totalDistricts}}</view><view class="stats-label">区县数</view></view>
          <view class="stats-tile"><view class="stats-number">{{previewResult.summary.matchedRows}}</view><view class="stats-label">已匹配用户</view></view>
          <view class="stats-tile"><view class="stats-number">{{previewResult.summary.unmatchedRows}}</view><view class="stats-label">未绑定用户</view></view>
          <view class="stats-tile"><view class="stats-number">{{previewResult.summary.errorRows}}</view><view class="stats-label">阻断错误</view></view>
          <view class="stats-tile"><view class="stats-number">{{previewResult.summary.quantitativeMismatchRows}}</view><view class="stats-label">量化差异</view></view>
          <view class="stats-tile"><view class="stats-number money">￥{{previewResult.summary.netPayTotalText}}</view><view class="stats-label">实发合计</view></view>
        </view>

        <view wx:if="{{previewResult.summary.districtSummaries.length}}" class="section-block">
          <view class="section-title">区县工资汇总</view>
          <view class="mini-list">
            <view class="mini-item" wx:for="{{previewResult.summary.districtSummaries}}" wx:key="district">
              <view class="mini-title">{{item.district}} · {{item.totalPeople}} 人</view>
              <view class="mini-sub">固定 ￥{{item.fixedPayTotalText}} · 量化 ￥{{item.quantitativePayTotalText}} · 实发 ￥{{item.netPayTotalText}}</view>
            </view>
          </view>
        </view>

        <view wx:if="{{previewResult.previewRows.length}}" class="section-block">
          <view class="section-title">人员预览</view>
          <view class="mini-list">
            <view class="mini-item" wx:for="{{previewResult.previewRows}}" wx:key="gridAccount">
              <view class="mini-title">{{item.district}} · {{item.personName}} / {{item.gridAccount}}</view>
              <view class="mini-sub">固定 ￥{{item.fixedPayText}} · 量化 ￥{{item.quantitativePayText}} · 实发 ￥{{item.netPayText}}</view>
              <view class="mini-sub">{{item.matchStatus === 'matched' ? '已匹配系统用户' : '尚未绑定系统用户'}}</view>
              <view wx:for="{{item.warningMessages}}" wx:key="*this" class="mini-sub warning-text">{{item}}</view>
            </view>
          </view>
        </view>

        <view wx:if="{{previewResult.blockingErrors.length}}" class="section-block">
          <view class="section-title warning-text">阻断错误</view>
          <view class="mini-list">
            <view class="mini-item warning-item" wx:for="{{previewResult.blockingErrors}}" wx:key="rowNo">
              <view class="mini-title">第 {{item.rowNo}} 行 · {{item.district || '未识别区县'}} · {{item.personName || '未识别人员'}} / {{item.gridAccount}}</view>
              <view class="mini-sub" wx:for="{{item.messages}}" wx:key="*this">{{item}}</view>
            </view>
          </view>
        </view>
      </view>

      <view class="card">
        <view class="card-header"><view class="card-title">导入批次</view><view class="tag tag-primary">{{batches.length}} 条</view></view>
        <view wx:if="{{batches.length}}" class="mini-list">
          <view class="mini-item" wx:for="{{batches}}" wx:key="batchNo">
            <view class="mini-title">{{item.sourceFileName}}</view>
            <view class="mini-sub">{{item.createTimeText}} · {{item.status}} · {{item.totalDistricts || 0}} 个区县 · {{item.successRows}} 人 · 实发合计 ￥{{item.netPayTotalText}}</view>
            <view wx:if="{{item.districtText}}" class="mini-sub">区县：{{item.districtText}}</view>
          </view>
        </view>
        <view wx:else class="empty-text">当前月份暂无整体工资导入批次</view>
      </view>
    </block>
  </view>
</scroll-view>
