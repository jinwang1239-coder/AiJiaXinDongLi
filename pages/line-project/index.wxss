.page-container {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(102, 182, 255, 0.14), transparent 34%),
    linear-gradient(180deg, #f6f8ff 0%, #eef6f1 100%);
}

.line-project-page {
  padding: 24rpx 20rpx 40rpx;
}

.workspace-card,
.month-card,
.management-card,
.admin-feedback-card,
.summary-card {
  margin-bottom: 20rpx;
}

.workspace-card {
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(246, 251, 255, 0.98) 100%);
  box-shadow: 0 18rpx 40rpx rgba(40, 84, 120, 0.08);
}

.workspace-main {
  margin-bottom: 24rpx;
}

.workspace-title {
  font-size: 42rpx;
  line-height: 1.2;
  color: #102033;
  font-weight: 700;
}

.workspace-subtitle {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: #0f766e;
  font-weight: 600;
}

.workspace-meta {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #6b7280;
}

.workspace-actions,
.summary-stats {
  display: flex;
}

.workspace-actions,
.summary-stats {
  gap: 18rpx;
}

.workspace-btn {
  flex: 1;
}

.workspace-btn {
  height: 76rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #1f2937;
  border: 1rpx solid #d7e4ef;
  box-shadow: 0 10rpx 20rpx rgba(15, 118, 110, 0.06);
}

.ghost-btn {
  background: #f8fbff;
  color: #334155;
}

.workspace-admin {
  margin-top: 18rpx;
}

.workspace-admin-row {
  display: flex;
  gap: 18rpx;
}

.workspace-admin-row .admin-import-btn {
  flex: 1;
  min-width: 0;
  width: auto;
}

.admin-import-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.month-picker {
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 2rpx solid #e8eef6;
  font-size: 30rpx;
  color: #111827;
}

.month-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.management-card {
  padding: 30rpx 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 40rpx rgba(15, 118, 110, 0.09);
}

.management-header,
.district-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.management-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #102033;
}

.management-scope,
.district-detail {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #778395;
}

.management-month {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 20rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 24rpx;
  font-weight: 600;
}

.management-total-label {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #64748b;
}

.management-total {
  margin-top: 8rpx;
  font-size: 54rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #0f8b72;
}

.management-stats,
.management-module-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.management-stats {
  margin-top: 22rpx;
}

.management-stat,
.management-module {
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f5f9f8;
}

.management-stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #102033;
}

.management-stat-label,
.management-module-name {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #748094;
}

.management-section-title {
  margin: 28rpx 0 16rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #243447;
}

.management-module-amount {
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #0f8b72;
}

.district-row + .district-row {
  margin-top: 20rpx;
}

.district-name,
.district-amount {
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
}

.district-amount {
  color: #0f8b72;
}

.district-track {
  height: 12rpx;
  margin-top: 10rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e8f1ef;
}

.district-bar {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #0f8b72 0%, #38b99c 100%);
}

.management-detail-btn {
  margin-top: 28rpx;
  width: 100%;
  border-radius: 18rpx;
}

.admin-feedback-card {
  padding: 30rpx 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 40rpx rgba(15, 118, 110, 0.09);
}

.admin-feedback-header,
.admin-feedback-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.admin-feedback-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #102033;
}

.admin-feedback-subtitle,
.admin-feedback-meta,
.admin-feedback-time {
  color: #748094;
  font-size: 23rpx;
}

.admin-feedback-subtitle {
  margin-top: 8rpx;
}

.admin-feedback-count {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 20rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 23rpx;
}

.admin-feedback-list {
  margin-top: 22rpx;
}

.admin-feedback-item {
  padding: 22rpx;
  border-radius: 20rpx;
  background: #f7faf9;
  border: 1rpx solid #e4eeeb;
}

.admin-feedback-item + .admin-feedback-item {
  margin-top: 18rpx;
}

.admin-feedback-person {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #203247;
}

.admin-feedback-meta {
  margin-top: 9rpx;
  line-height: 1.5;
}

.admin-feedback-content {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #334155;
  font-size: 25rpx;
  line-height: 1.6;
}

.admin-review-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 14rpx;
}

.admin-review-item {
  padding: 16rpx;
  border-radius: 16rpx;
  background: #eef6f4;
}

.admin-review-role {
  margin-bottom: 10rpx;
  color: #475569;
  font-size: 22rpx;
}

.admin-feedback-time {
  margin-top: 14rpx;
  text-align: right;
}

.summary-card {
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0f5f7b 0%, #13808b 48%, #20a58f 100%);
  color: #ffffff;
  box-shadow: 0 20rpx 36rpx rgba(19, 128, 139, 0.18);
}

.summary-label,
.summary-stat-label,
.summary-stat-value {
  color: #ffffff;
}

.summary-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.summary-amount {
  margin-top: 14rpx;
  font-size: 60rpx;
  line-height: 1.1;
  font-weight: 700;
  color: #ffffff;
}

.summary-formula {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8rpx);
}

.summary-formula-title {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.92);
}

.summary-formula-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.summary-formula-item {
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.12);
}

.summary-formula-item-active {
  background: rgba(255, 255, 255, 0.2);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.3);
}

.summary-formula-name {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.summary-formula-value {
  margin-top: 6rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
}

.summary-stats {
  margin-top: 28rpx;
}

.summary-stat {
  flex: 1;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(8rpx);
}

.summary-stat-value {
  font-size: 34rpx;
  font-weight: 700;
}

.summary-stat-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.summary-feedback {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.14);
  backdrop-filter: blur(8rpx);
}

.summary-feedback-header,
.summary-feedback-actions {
  display: flex;
  align-items: center;
}

.summary-feedback-header {
  justify-content: space-between;
  gap: 14rpx;
}

.summary-feedback-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.status-pending {
  background: rgba(255, 255, 255, 0.9);
  color: #5f6b7a;
}

.status-processing {
  background: #e8f3ff;
  color: #1f8df3;
}

.status-approved {
  background: #e8f8ef;
  color: #1d8f54;
}

.status-rejected {
  background: #ffecec;
  color: #d64c4c;
}

.summary-feedback-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.9);
}

.summary-feedback-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.78);
}

.summary-feedback-actions {
  gap: 14rpx;
  margin-top: 18rpx;
}

.summary-feedback-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 72rpx;
  line-height: 1;
  padding: 0;
  border-radius: 16rpx;
  border: none;
  background: #ffffff;
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}

.summary-feedback-btn-ghost {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
}

.summary-feedback-btn::after {
  border: none;
}

.mini-btn {
  min-width: 120rpx;
  padding: 0 24rpx;
}

.empty-text {
  padding: 20rpx 0;
  font-size: 25rpx;
  color: #9ca3af;
}

@media (max-width: 540px) {
  .summary-formula-grid,
  .summary-stats {
    grid-template-columns: 1fr;
  }

  .summary-stats {
    flex-direction: column;
  }
}
