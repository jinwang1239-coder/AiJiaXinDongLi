<navigation-bar title="业务收集系统" back="{{false}}" color="black" background="#FFF"></navigation-bar>

<scroll-view class="page-container" scroll-y type="list">
  <view class="login-container">
    <view wx:if="{{!hasUserInfo}}" class="login-section">
      <view class="login-header">
        <view class="app-title">请选择工作界面</view>
        <view class="app-subtitle">登录前先选择入口，登录后系统会按账号已配置的界面类型进入对应工作台。</view>
      </view>

      <view class="workspace-selector">
        <view
          class="workspace-option {{selectedWorkspaceType === 'sales' ? 'workspace-option-active' : ''}}"
          data-workspace-type="sales"
          bindtap="selectWorkspace"
        >
          <view class="workspace-option-title">销售界面</view>
          <view class="workspace-option-desc">员工编号认领、酬金查看、业务量查询。</view>
        </view>

        <view
          class="workspace-option {{selectedWorkspaceType === 'line_project' ? 'workspace-option-active' : ''}}"
          data-workspace-type="line_project"
          bindtap="selectWorkspace"
        >
          <view class="workspace-option-title">集客线路界面</view>
          <view class="workspace-option-desc">适合集客人员，包含线路项目统计、按人员、按工单与导入批次。</view>
        </view>
      </view>

      <view class="workspace-hint">{{loginPrompt}}</view>

      <view class="login-actions">
        <button class="btn btn-primary login-btn" bindtap="onLogin" loading="{{loading}}">
          <text wx:if="{{!loading}}">进入并登录</text>
          <text wx:else>登录中...</text>
        </button>
      </view>
    </view>

    <view wx:else class="user-section">
      <view class="user-card">
        <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <view class="user-content">
          <view class="user-line">姓名：{{profileDisplayName}}</view>
          <view class="user-subtitle">{{roleText}}</view>
          <view class="user-subtitle">{{profileSubtitle}}</view>
        </view>
        <view class="user-tools">
          <button class="tool-btn" bindtap="openProfileModal">{{isEmployee ? '个人信息' : '管理资料'}}</button>
          <button class="tool-btn tool-btn-ghost" bindtap="onLogout">退出登录</button>
        </view>
      </view>

      <view class="feedback-card" wx:if="{{canImport}}">
        <button class="feedback-btn" bindtap="navigateToImport">销售月度业务量导入</button>
      </view>
      <view class="feedback-card" wx:if="{{canMaintain}}">
        <button class="feedback-btn" bindtap="navigateToMaintenance">认领与数据维护</button>
      </view>
      <picker mode="date" fields="month" value="{{monthLabel}}" bindchange="onMonthChange"><view class="feedback-card">{{isEmployee ? '查看月份' : '统计月份'}}：{{monthLabel}} ▾</view></picker>
      <view wx:if="{{loading}}">加载中…</view>
      <view class="feedback-card" wx:if="{{errorText}}">{{errorText}}</view>
      <view class="feedback-card" wx:if="{{receiptWarning}}">{{receiptWarning}}</view>
      <view class="feedback-card" wx:if="{{managerClaimPending}}" bindtap="openProfileModal">请先完成管理人员认领，点击填写资料。</view>
      <sales-participation wx:if="{{!isEmployee}}" value="{{participation}}" scope-label="{{scopeLabel}}" can-export="{{canExportParticipation}}" exporting="{{exportingParticipation}}" bind:export="onExportParticipation" />
      <view class="salary-card" wx:if="{{isEmployee && !managerClaimPending && !loading && !errorText}}">
        <view class="salary-banner">{{monthLabel}} 业务预计总酬金 · {{monthStatus}}</view>
        <view class="salary-body">
          <view class="salary-amount">￥{{stats.monthCommission}}</view>
          <view class="salary-note">该月共完成 {{stats.monthRecords || 0}} 笔业务 · {{cutoffDate ? '截至' + cutoffDate : '暂无数据'}}</view>
        </view>
      </view>

      <view class="detail-card" wx:if="{{isEmployee && !managerClaimPending && !loading && !errorText}}">
        <view class="detail-header">业务量与酬金明细</view>
        <view class="detail-grid">
          <view class="detail-item">
            <view class="detail-label">截至{{monthLabel}}计划到期酬金</view>
            <view class="detail-value">￥{{stats.settledCommission}}</view>
          </view>
          <view class="detail-item">
            <view class="detail-label">{{monthLabel}}预计核发（含历史分期）</view>
            <view class="detail-value detail-money">￥{{stats.currentDue}}</view>
          </view>
          <view class="detail-item">
            <view class="detail-label">所选月业务量</view>
            <view class="detail-value">{{stats.monthRecords}} 笔</view>
          </view>
          <view class="detail-item">
            <view class="detail-label">所选月业务总酬金</view>
            <view class="detail-value detail-money">￥{{stats.monthCommission}}</view>
          </view>
          <view class="detail-item">
            <view class="detail-label">累计业务量</view>
            <view class="detail-value">{{stats.totalRecords}} 笔</view>
          </view>
          <view class="detail-item">
            <view class="detail-label">累计酬金</view>
            <view class="detail-value detail-money">￥{{stats.totalCommission}}</view>
          </view>
        </view>
      </view>

      <view class="feedback-card" wx:if="{{!managerClaimPending && (isEmployee || canHandleFeedback)}}">
        <view class="feedback-tip">{{isEmployee ? '如对酬金有异议，可提交反馈并查看处理进度。' : '处理分配给本人的销售酬金反馈。'}}</view>
        <button class="feedback-btn" bindtap="navigateToFeedback">{{isEmployee ? '我的酬金反馈' : '待处理反馈（' + pendingCount + '）'}}</button>
      </view>
      <view wx:if="{{feedbackError}}">{{feedbackError}}</view>
    </view>
  </view>
</scroll-view>

<view wx:if="{{showProfileModal}}" class="modal-mask" bindtap="closeProfileModal">
  <view class="modal-panel" catchtap="stopModalPropagation">
    <view class="modal-header">
      <view class="modal-title">补充个人信息</view>
      <view class="modal-close" bindtap="closeProfileModal">×</view>
    </view>

    <view class="claim-tabs" wx:if="{{isEmployee && !managerClaimPending}}">
      <view class="claim-tab {{claimMode === 'employee' ? 'claim-tab-active' : ''}}" data-mode="employee" bindtap="onClaimModeChange">员工认领</view>
      <view class="claim-tab {{claimMode === 'manager' ? 'claim-tab-active' : ''}}" data-mode="manager" bindtap="onClaimModeChange">管理人员认领</view>
    </view>
    <block wx:if="{{claimMode === 'manager'}}">
      <view class="form-group">
        <view class="form-label">姓名</view>
        <input class="form-input" placeholder="请输入本人姓名" value="{{profileForm.realName}}" data-field="realName" bindinput="onProfileInputChange" disabled="{{savingProfile}}" />
      </view>
      <view class="form-group">
        <view class="form-label">网格通账号</view>
        <input class="form-input" placeholder="请输入网格通账号" type="number" maxlength="11" value="{{profileForm.gridAccount}}" data-field="gridAccount" bindinput="onProfileInputChange" disabled="{{savingProfile}}" />
      </view>
      <view>与预录管理名单匹配后绑定当前微信，后续登录自动识别。</view>
    </block>
    <view class="form-group" wx:else>
      <view class="form-label">员工编号</view>
      <input class="form-input" placeholder="输入管理员已导入的员工编号" value="{{profileForm.employeeId}}" disabled="{{claimed}}" data-field="employeeId" bindinput="onProfileInputChange" />
      <view>填写编号即可认领，姓名、区县和网格由导入资料自动取得。</view>
    </view>
    <button class="submit-btn" bindtap="submitProfile" loading="{{savingProfile}}" disabled="{{savingProfile}}">{{claimMode === 'manager' ? '认领管理身份' : '认领员工编号'}}</button>
  </view>
</view>
