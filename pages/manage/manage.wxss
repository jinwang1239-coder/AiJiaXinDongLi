.page-container { height: 100vh; background: #f5f7fa; }
.manage-container { padding: 24rpx 24rpx 160rpx; }
.card { background: #fff; padding: 28rpx; border-radius: 20rpx; margin-bottom: 22rpx; }
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; }
.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 26rpx; }
.stats-number, .amount { font-size: 38rpx; color: #4668c9; margin: 10rpx 0; }
.hint { color: #7a8395; font-size: 25rpx; padding: 16rpx 0; }
.filter-field { padding: 20rpx 0; border-bottom: 1rpx solid #edf0f5; }
.manage-container .form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.actions { display: flex; flex-wrap: wrap; margin-top: 20rpx; gap: 12rpx; }
.record { line-height: 1.8; }
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,.4); display: flex; align-items: center; justify-content: center; z-index: 1000; }
.modal-panel { width: 82%; max-height: 80vh; overflow-y: auto; background: #fff; padding: 30rpx; border-radius: 20rpx; }
