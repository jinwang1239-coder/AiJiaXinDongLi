<navigation-bar title="销售月度业务" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="page-container" scroll-y bindscrolltolower="onReachBottom">
  <view class="manage-container">
    <view class="card" wx:if="{{!loading && !error}}">
      <view class="card-title">业务量与酬金</view>
      <view class="stats-grid">
        <view>筛选业务量<view class="stats-number">{{stats.totalRecords || 0}}笔</view></view>
        <view>筛选预计总酬金<view class="stats-number">￥{{stats.totalCommission || '0.00'}}</view></view>
        <view>已到计划核发月<view>￥{{stats.settledCommission || '0.00'}}</view></view>
        <view>后续预计核发<view>￥{{stats.unsettledCommission || '0.00'}}</view></view>
      </view>
      <view class="hint">按办理数量统计，计划进度截至{{referenceMonth}}，不代表实际工资到账。</view>
    </view>
    <view class="card">
      <picker mode="date" fields="month" bindchange="onMonthChange"><view class="filter-field">{{filters.businessMonth || '选择业务月份'}}</view></picker>
      <picker range="{{districts}}" bindchange="onDistrictChange"><view class="filter-field">{{filters.district || '选择区县'}}</view></picker>
      <picker range="{{businessTypes}}" bindchange="onBusinessChange"><view class="filter-field">{{filters.businessName || '选择业务类型'}}</view></picker>
      <input class="form-input" placeholder="姓名或员工编号" value="{{filters.developer}}" bindinput="onSearchInput" bindconfirm="search" />
      <view class="actions">
        <button size="mini" bindtap="search">查询</button><button size="mini" bindtap="resetFilter">重置</button><button size="mini" bindtap="showAllMonths">全部月份</button><button size="mini" bindtap="exportData" disabled="{{loading || !appliedFilters}}">导出Excel</button>
      </view>
    </view>
    <view class="card record" wx:for="{{records}}" wx:key="_id" bindtap="openDetail" data-index="{{index}}">
      <view class="card-title">{{item.businessName}} · {{item.quantity}}笔</view>
      <view>{{item.developer}} / {{item.employeeId}}</view>
      <view>{{item.businessMonth}} · {{item.district}} · {{item.statusText}}</view>
      <view class="amount">￥{{item.commission}}</view>
      <view class="hint">统计截至{{item.cutoffDate}}，点击查看分月金额</view>
    </view>
    <view class="hint" wx:if="{{error}}">{{error}}</view>
    <view class="hint" wx:if="{{receiptWarning}}">{{receiptWarning}}</view>
    <view class="hint" wx:if="{{!loading && !error && !records.length}}">当前筛选范围内暂无非零业务，请检查月份和筛选条件。</view>
    <view class="hint" wx:if="{{loading}}">加载中…</view>
  </view>
</scroll-view>
<view class="modal-mask" wx:if="{{showDetail}}" bindtap="closeDetail">
  <view class="modal-panel" catchtap="stopTap">
    <view class="card-title">{{detail.businessName}} · {{detail.quantity}}笔</view>
    <view>{{detail.employeeId}} {{detail.developer}}</view>
    <view class="filter-field" wx:for="{{detail.settlementSchedule}}" wx:key="month">{{item.period}} / {{item.settlementMonth}}：￥{{item.amountText}} · {{item.statusText}}</view>
    <button bindtap="closeDetail">关闭</button>
  </view>
</view>
