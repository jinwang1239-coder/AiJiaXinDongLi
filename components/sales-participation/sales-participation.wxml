<view class="receipt-card" wx:if="{{value}}">
  <view class="title-row">
    <view class="title">{{scopeLabel}}员工数据接收情况</view>
    <button wx:if="{{canExport}}" class="export-btn" size="mini" bindtap="onExport" loading="{{exporting}}" disabled="{{exporting}}">{{exporting ? '正在导出' : '导出接收明细'}}</button>
  </view>
  <picker wx:if="{{canExport}}" mode="selector" range="{{exportScopes}}" value="{{exportScopeIndex}}" disabled="{{exporting}}" bindchange="onExportScopeChange">
    <view class="export-scope">导出范围：{{exportScopes[exportScopeIndex]}} ▾</view>
  </picker>
  <view class="stats-grid">
    <view>应接收次数<view class="number">{{value.expected}}次</view></view>
    <view>已接收次数<view class="number">{{value.received}}次</view></view>
    <view>未接收次数<view class="number">{{value.pending}}次</view></view>
    <view>参与率<view class="number">{{value.rate}}</view></view>
  </view>
  <view class="counts">覆盖{{value.employeeCount}}名员工 · 涉及{{value.batchCount}}批导入</view>
  <view class="counts">参与率＝已接收次数÷应接收次数，同一员工同一批次只计一次。</view>
  <view class="district" wx:for="{{value.districts}}" wx:key="district">
    <view class="header"><text>{{item.district}}</text><text class="rate">{{item.rate}}</text></view>
    <view class="counts">应接收 {{item.expected}}次 · 已接收 {{item.received}}次 · 未接收 {{item.pending}}次</view>
    <view class="counts">覆盖{{item.employeeCount}}名员工 · 涉及{{item.batchCount}}批导入</view>
  </view>
</view>
